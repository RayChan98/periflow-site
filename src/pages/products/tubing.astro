---
// 泵管产品页：铂金硫化硅胶 + PTFE 内衬复合管
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

const sizeChart = [
  ['13#', '0.8', '4.0', 'Low-flow dosing, small instruments'],
  ['14#', '1.6', '4.8', 'Lab transfer, reagent dosing'],
  ['16#', '3.1', '6.3', 'General lab and production transfer'],
  ['19#', '2.4', '4.8', 'Medium-flow transfer, filling'],
  ['25#', '4.8', '8.0', 'Higher-flow transfer on YZ35 heads'],
  ['15#', '4.8', '8.0', 'High-flow silicone duty'],
  ['17#', '6.4', '9.6', 'High-flow transfer, slurry handling'],
  ['18#', '7.9', '11.1', 'Maximum-flow duty up to 4560 ml/min'],
];

const materialSpecs = [
  ['Platinum-Cured Silicone', 'Ultra-pure, low extractables', '-40 to 200°C', 'Clean fluids, biotech, food'],
  ['PTFE-Lined Composite', 'Chemically inert inner bore', 'Chemical duty', '98% sulfuric acid, 40% NaOH'],
];

const features = [
  { title: 'Platinum-Cured Purity', desc: 'No peroxide by-products — low extractables and excellent biocompatibility for biotech and pharmaceutical transfer.' },
  { title: 'PTFE-Lined Chemical Armor', desc: 'A PTFE inner liner shrugs off media that destroys plain silicone — including 98% sulfuric acid and 40% NaOH.' },
  { title: 'Seven Standard Sizes', desc: '13# to 18# plus 19# and 25# cover the full flow window from 0.014 to 4560 ml/min on YZ15/YZ35 heads.' },
  { title: 'Wide Temperature Range', desc: 'Silicone tubing operates from -40°C to 200°C, so cold reagent lines and hot-fill processes both stay reliable.' },
  { title: 'Long Flex Life', desc: 'Consistent wall thickness and even roller compression mean predictable service life — and predictable maintenance schedules.' },
  { title: 'Traceable, Packed for Production', desc: 'Laser-marked sizes and clean packing options (single sets or bulk reels) for OEM and distributor programs.' },
];

const applications = ['Chemical Dosing', 'Acid & Alkali Transfer', 'Biopharma Processing', 'Food & Beverage', 'Printing & Ink', 'Wastewater Sampling', 'Lab Media Dispensing', 'Ceramic Slurry'];

const faqs = [
  { q: 'What is the difference between silicone and PTFE-lined tubing?', a: 'Platinum-cured silicone is the all-round choice — pure, flexible and rated -40 to 200°C. PTFE-lined composite adds an inert inner liner for aggressive chemicals like 98% sulfuric acid or 40% NaOH that would degrade silicone.' },
  { q: 'Which tube size do I need?', a: 'Match the bore to your flow window. Small bores (13#/14#) suit low-flow dosing; larger bores (17#/18#) deliver the top of the range up to 4560 ml/min on YZ35 heads.' },
  { q: 'Can I use the same tubing on all PERIFLOW heads?', a: 'Yes — YZ15, YZ35 and LP15-6 heads all accept the standard 13#-18# family, plus 19# and 25# where the head supports it. One tubing inventory across your machines.' },
  { q: 'How does the -40 to 200°C rating work in practice?', a: 'Silicone stays flexible at cold temperatures and survives hot processes up to 200°C. For sustained high temperatures or steam exposure, confirm the cycle conditions with us — we will spec the right material.' },
  { q: 'Can you cut and pre-pack tubes to length?', a: 'Yes. We supply cut-to-length tube sets per pump head, bulk reels for production, and custom lengths for OEM assemblies.' },
  { q: 'How often should I replace pump tubing?', a: 'Replace on a fixed schedule based on hours of use, speed and fluid aggressiveness. In continuous light duty, platinum silicone often runs for months; heavy chemical duty may need faster changes — we help you set the interval.' },
];
---

<Layout
  title="Peristaltic Pump Tubing — Silicone & PTFE-Lined | PERIFLOW"
  description="PERIFLOW pump tubing — platinum-cured silicone and PTFE-lined composite tubes in 13#-18# sizes, -40 to 200°C, compatible with 98% sulfuric acid and 40% NaOH for chemical duty."
>
  <!-- Hero -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="text-sm font-semibold text-brand-green">PUMP TUBING</p>
      <h1 class="mt-2 max-w-3xl text-3xl font-extrabold tracking-tight sm:text-4xl">Tubing That Decides How Long Your Pump Stays Productive</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300">
        Platinum-cured silicone for pure transfer, PTFE-lined composite for chemical attack — seven standard sizes from 13# to 18#, rated -40 to 200°C.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <button type="button" data-quote-open class="rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white shadow-lg transition hover:bg-orange-600">Get a Quote</button>
        <a href="#size-chart" class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Explore the Size Chart</a>
      </div>
    </div>
  </section>

  <!-- 材质对比表 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950 sm:text-3xl">Material Options</h2>
      <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-navy-950 text-white">
            <tr>
              <th class="px-6 py-3.5 font-semibold">Material</th>
              <th class="px-6 py-3.5 font-semibold">Key Property</th>
              <th class="px-6 py-3.5 font-semibold">Temperature</th>
              <th class="px-6 py-3.5 font-semibold">Best For</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {materialSpecs.map(([mat, prop, temp, use], i) => (
              <tr class:list={['transition hover:bg-slate-50', i % 2 === 1 ? 'bg-slate-50/60' : 'bg-white']}>
                <td class="px-6 py-3 font-medium text-navy-950">{mat}</td>
                <td class="px-6 py-3 text-slate-600">{prop}</td>
                <td class="px-6 py-3 text-slate-600">{temp}</td>
                <td class="px-6 py-3 text-slate-600">{use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 规格尺寸表 -->
  <section id="size-chart" class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950 sm:text-3xl">Size Chart (13# - 18#)</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-600">Standard peristaltic tube sizes with inner and outer diameters in millimetres. All sizes available in platinum-cured silicone; PTFE-lined composite on request.</p>
      <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-navy-950 text-white">
            <tr>
              <th class="px-6 py-3.5 font-semibold">Tube No.</th>
              <th class="px-6 py-3.5 font-semibold">Inner Ø (mm)</th>
              <th class="px-6 py-3.5 font-semibold">Outer Ø (mm)</th>
              <th class="px-6 py-3.5 font-semibold">Typical Use</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {sizeChart.map(([no, id, od, use], i) => (
              <tr class:list={['transition hover:bg-slate-50', i % 2 === 1 ? 'bg-slate-50/60' : 'bg-white']}>
                <td class="px-6 py-3 font-medium text-navy-950">{no}</td>
                <td class="px-6 py-3 text-slate-600">{id}</td>
                <td class="px-6 py-3 text-slate-600">{od}</td>
                <td class="px-6 py-3 text-slate-600">{use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-slate-400">* Standard industry sizing. Confirm exact dimensions with the current datasheet before production runs.</p>
    </div>
  </section>

  <!-- 特性清单 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950 sm:text-3xl">Why Buyers Standardise on PERIFLOW Tubing</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-base font-bold text-navy-950">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 应用场景 -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-extrabold text-navy-950 sm:text-3xl">Applications</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {applications.map((a) => (
          <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700">{a}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold text-brand-blue">FAQ</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Questions Buyers Ask</h2>
      <div class="mt-8 grid gap-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-bold text-navy-950">
              {f.q}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0 text-slate-400 transition group-open:rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Which Tubing Material Fits Your Fluid?"
    subtitle="Tell us your fluid, temperature and duty cycle — we will spec the right tube material and size within 24 hours."
  />
</Layout>
