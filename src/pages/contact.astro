---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | PERIFLOW Peristaltic Pump Manufacturer" description="Contact PERIFLOW for pump heads, tubing, lab pumps and OEM/ODM volume pricing">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h1 class="text-4xl font-extrabold tracking-tight">Contact Us</h1>
      <p class="mt-3 max-w-2xl text-lg text-slate-300">Factory-direct peristaltic pump manufacturer. Our sales team replies within 24 hours.</p>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-5">
        <!-- 联系信息 -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-extrabold text-navy-950">Get in Touch</h2>
          <div class="mt-6 space-y-4">
            {[
              ['Email', 'cj226144@gmail.com'],
              ['WhatsApp', '+86 137 1086 0663'],
              ['WeChat', 'PERIFLOW'],
              ['Address', 'Guangzhou, China'],
            ].map(([k, v]) => (
              <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-blue/10 text-brand-blue">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-medium uppercase tracking-wide text-slate-400">{k}</p>
                  <p class="font-semibold text-navy-950">{v}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 询盘表单 -->
        <div id="rfq" class="lg:col-span-3">
          <h2 class="text-2xl font-extrabold text-navy-950">Request a Quote</h2>
          <form id="inquiry-form" class="mt-6 space-y-5 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8" action="/api/contact" method="post">
            <input type="hidden" name="form_source" value="contact-page" />
            <input type="text" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-navy-950">Your Name *</label>
                <input id="name" name="name" type="text" required placeholder="John Smith" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20" />
              </div>
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-navy-950">Business Email *</label>
                <input id="email" name="email" type="email" required placeholder="name@company.com" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20" />
              </div>
            </div>
            <div>
              <label for="company" class="mb-1.5 block text-sm font-medium text-navy-950">Company Name</label>
              <input id="company" name="company" type="text" placeholder="Your company" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20" />
            </div>
            <div>
              <label for="product" class="mb-1.5 block text-sm font-medium text-navy-950">Product of Interest</label>
              <select id="product" name="product" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20">
                <option>Pump Heads (YZ15 / YZ35 / LP)</option>
                <option>Pump Tubing (Silicone / PTFE)</option>
                <option>Benchtop Pumps (Lab)</option>
                <option>Dosing Pumps (Chemical)</option>
                <option>OEM / ODM Custom</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="quantity" class="mb-1.5 block text-sm font-medium text-navy-950">Estimated Quantity</label>
              <input id="quantity" name="quantity" type="text" placeholder="e.g. 100 pcs" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20" />
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-navy-950">Message *</label>
              <textarea id="message" name="message" rows="5" required placeholder="Tell us about your application: pump type, flow rate, tubing material, quantity..." class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-blue/20"></textarea>
            </div>
            <button type="submit" class="w-full rounded-lg bg-cta-orange px-6 py-3 text-base font-semibold text-white shadow-lg transition hover:bg-orange-600 disabled:opacity-60 sm:w-auto">
              Send Inquiry
            </button>
            <p id="form-status" class="hidden text-sm font-medium"></p>
          </form>
          <script>
            const form = document.getElementById('inquiry-form');
            const statusEl = document.getElementById('form-status');
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const btn = form.querySelector('button[type="submit"]');
              btn.disabled = true;
              btn.textContent = 'Sending...';
              statusEl.classList.add('hidden');
              try {
                const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
                const data = await res.json();
                if (data.ok) {
                  window.location.href = '/thank-you/';
                } else {
                  statusEl.textContent = data.error === 'mail_not_configured'
                    ? 'Service temporarily unavailable. Please email us directly at cj226144@gmail.com.'
                    : 'Something went wrong. Please email us directly at cj226144@gmail.com.';
                  statusEl.classList.remove('hidden');
                  statusEl.classList.add('text-red-600');
                }
              } catch (err) {
                statusEl.textContent = 'Network error. Please email us directly at cj226144@gmail.com.';
                statusEl.classList.remove('hidden');
                statusEl.classList.add('text-red-600');
              }
              btn.disabled = false;
              btn.textContent = 'Send Inquiry';
            });
          </script>
        </div>
      </div>
    </div>
  </section>
</Layout>
