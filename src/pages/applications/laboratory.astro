---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

const title = 'Laboratory Peristaltic Pumps — Cell Culture, Media Dispensing & Crystallization';
const description = 'PERIFLOW laboratory peristaltic pumps for cell culture, media dispensing and crystallization — contamination-free flow, ±1% precision and RS485 automation for the modern lab.';

const why = [
  { title: 'Contamination-Free, Sterile-Safe Flow', desc: 'Fluid touches only the inner bore of the pump tube. No seals, no dead volume, no cross-contamination between media batches.' },
  { title: 'Low-Shear Pumping Protects Cells', desc: 'The gentle squeezing action keeps cell cultures, proteins and shear-sensitive reagents intact during transfer and feeding.' },
  { title: '±1% Dispensing Precision', desc: 'Digital speed control delivers accurate, repeatable volumes for media dispensing, reagent dosing and crystallization feed.' },
  { title: 'RS485 & Remote Control Ready', desc: 'Integrate pumps into automated protocols with RS485 serial control, analog speed input and external start/stop signals.' },
];

const tableRows = [
  { application: 'Cell culture media dispensing', requirement: 'Sterile, low-shear, accurate volume per well or flask', product: 'Benchtop pumps' },
  { application: 'Media & buffer transfer', requirement: 'Contamination-free, easy tube replacement', product: 'Benchtop pumps, pump heads' },
  { application: 'Crystallization feed', requirement: 'Slow, stable, precisely controlled flow rate', product: 'Benchtop pumps, pump heads' },
  { application: 'Reagent & additive dosing', requirement: 'Repeatable small volumes, RS485 control', product: 'Benchtop pumps' },
  { application: 'Filtration & harvest transfer', requirement: 'Gentle handling, run-dry safety', product: 'Pump heads, tubing' },
];

const products = [
  { href: '/products/benchtop-pumps/', title: 'Benchtop Pumps', desc: 'Variable-speed lab pumps with touchscreen control, RS485 and precise dispensing.' },
  { href: '/products/pump-heads/', title: 'Pump Heads', desc: 'YZ15/YZ35/LP series heads for multi-tube, multi-channel laboratory setups.' },
  { href: '/products/tubing/', title: 'Pump Tubing', desc: 'Platinum-cured silicone and PTFE-lined tubing in 13#-18# sizes.' },
];

const faqs = [
  { q: 'Can a peristaltic pump handle sterile media without contamination?', a: 'Yes. The media only contacts the tube interior, and the closed tubing path keeps the flow sterile. Replace the tube between batches for single-use-style operation.' },
  { q: 'Is peristaltic pumping safe for cell cultures?', a: 'The low-shear squeezing action is gentle on cells and proteins, making peristaltic pumps the standard choice for cell culture transfer and bioreactor feeding.' },
  { q: 'How do I automate dispensing with my existing lab system?', a: 'Our benchtop pumps support RS485 serial control plus analog and external trigger inputs, so they integrate with most lab automation and LIMS setups.' },
  { q: 'What dispensing accuracy can I expect?', a: 'With calibrated tubing, PERIFLOW benchtop pumps deliver ±1% flow repeatability — consistent well-to-well and batch-to-batch.' },
  { q: 'Which tubing should I use for organic solvents in crystallization?', a: 'For aggressive solvents, choose PTFE-lined tubing. For aqueous crystallization work, platinum-cured silicone is the standard choice.' },
  { q: 'Do you offer multi-channel configurations for parallel dispensing?', a: 'Yes — our pump heads support multi-channel tube configurations, and OEM multi-channel designs are available for higher-throughput dispensing.' },
];
---

<Layout title={title} description={description}>
  <!-- Hero -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <nav class="flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-white">Home</a>
        <span>/</span>
        <a href="/applications/" class="transition hover:text-white">Applications</a>
        <span>/</span>
        <span class="text-slate-200">Laboratory</span>
      </nav>
      <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-brand-green">APPLICATIONS</p>
      <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">Laboratory Peristaltic Pumps for Cell Culture & Media Dispensing</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-300">Keep your cultures healthy and your dispensing consistent. PERIFLOW laboratory peristaltic pumps deliver contamination-free, low-shear flow with the precision and automation today's labs demand.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <button type="button" data-quote-open class="rounded-lg bg-cta-orange px-6 py-3 text-center text-base font-semibold text-white shadow-lg transition hover:bg-orange-600">Request a Quote</button>
        <a href="/products/benchtop-pumps/" class="rounded-lg border border-white/20 px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-white/10">View Benchtop Pumps</a>
      </div>
    </div>
  </section>

  <!-- Why peristaltic -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">Why Peristaltic for the Lab</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Why Laboratory Work Needs Peristaltic Pumps</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {why.map((w) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-navy-950">{w.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Application table -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">LAB SCENARIOS</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Laboratory Application Scenarios</h2>
      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-navy-950 text-white">
            <tr>
              <th class="px-5 py-4 font-semibold">Application</th>
              <th class="px-5 py-4 font-semibold">Typical Requirement</th>
              <th class="px-5 py-4 font-semibold">Recommended Product</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tableRows.map((r) => (
              <tr class="transition hover:bg-slate-50">
                <td class="px-5 py-4 font-bold text-navy-950">{r.application}</td>
                <td class="px-5 py-4 text-slate-600">{r.requirement}</td>
                <td class="px-5 py-4 text-slate-600">{r.product}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Recommended products -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">RECOMMENDED</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Recommended for Your Lab</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {products.map((p) => (
          <a href={p.href} class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <h3 class="text-base font-bold text-navy-950">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue">View product <span class="transition group-hover:translate-x-0.5">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">FAQ</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Laboratory Pump Questions</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer text-base font-bold text-navy-950">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Need a Pump for Your Specific Protocol?"
    subtitle="Tell us the liquid, volumes and flow rate — we'll recommend the right lab pump and tubing within 24 hours."
  />
</Layout>
