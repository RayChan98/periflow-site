---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';

const title = 'Food & Beverage Peristaltic Pumps — Hygienic Transfer, Filling & Condiment Dispensing';
const description = 'PERIFLOW peristaltic pumps for food & beverage — hygienic transfer, filling and condiment dispensing with FDA-grade platinum-cured silicone tubing.';

const why = [
  { title: 'FDA-Grade Silicone Tubing', desc: 'Platinum-cured silicone tubing is available in FDA-compliant grades — the only component that touches your product.' },
  { title: 'Hygienic by Design', desc: 'Fluid flows through a closed tube; there are no crevices, seals or dead zones where product can hide. Tube changes take minutes.' },
  { title: 'Gentle on Shear-Sensitive Products', desc: 'Emulsions, fruit pulp, sauces and marinades move without separation or damage — quality stays consistent batch after batch.' },
  { title: 'Accurate Filling & Dispensing', desc: 'Digitally controlled speed delivers consistent fill volumes and repeatable condiment portions, reducing giveaway and waste.' },
];

const tableRows = [
  { application: 'Hygienic product transfer', requirement: 'FDA-grade contact, easy cleaning, gentle flow', product: 'Pump heads, tubing' },
  { application: 'Filling & portioning', requirement: 'Consistent volume, ±1% repeatability', product: 'Benchtop pumps, pump heads' },
  { application: 'Condiment & sauce dispensing', requirement: 'Viscous, shear-sensitive fluids, accurate doses', product: 'Benchtop pumps, pump heads' },
  { application: 'Juice & syrup handling', requirement: 'Contamination-free, quick tube change between flavors', product: 'Pump heads, tubing' },
  { application: 'R&D and pilot-plant trials', requirement: 'Flexible flow rates, small batches, easy setup', product: 'Benchtop pumps' },
];

const products = [
  { href: '/products/pump-heads/', title: 'Pump Heads', desc: 'YZ15/YZ35/LP series heads sized for food transfer and filling lines.' },
  { href: '/products/tubing/', title: 'Pump Tubing', desc: 'FDA-grade platinum-cured silicone and PTFE-lined tubing in 13#-18# sizes.' },
  { href: '/products/benchtop-pumps/', title: 'Benchtop Pumps', desc: 'Variable-speed pumps for pilot filling, portioning and R&D trials.' },
];

const faqs = [
  { q: 'Is the tubing food-safe?', a: 'Yes. We supply FDA-grade platinum-cured silicone tubing for food contact. It is non-toxic, odorless and withstands repeated cleaning.' },
  { q: 'Can peristaltic pumps handle thick sauces and pastes?', a: 'Yes. Larger-bore tubing and slower roller speeds move viscous products reliably, and the low-shear action keeps emulsions and pulp intact.' },
  { q: 'How do I prevent flavor carryover between batches?', a: 'Because the product only touches the tube, you simply swap in a fresh tube between flavors — no stripping or deep-cleaning the pump head.' },
  { q: 'How accurate is filling with a peristaltic pump?', a: 'With calibrated tubing, PERIFLOW pumps deliver ±1% fill repeatability, cutting product giveaway and keeping portion sizes consistent.' },
  { q: 'Do you supply complete filling systems?', a: 'We supply pumps, heads and tubing as building blocks, plus OEM configurations for filling machines. Our engineers can help you design the dosing layout.' },
  { q: 'Can the pump be cleaned in place?', a: 'The pump head can be rinsed externally, and the tubing itself is the flow path — for CIP-style needs, many customers use dedicated clean tubes and swap them out.' },
];
---

<Layout title={title} description={description}>
  <!-- Hero -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <nav class="flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-white">Home</a>
        <span>/</span>
        <a href="/applications/" class="transition hover:text-white">Applications</a>
        <span>/</span>
        <span class="text-slate-200">Food & Beverage</span>
      </nav>
      <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-brand-green">APPLICATIONS</p>
      <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">Food & Beverage Peristaltic Pumps for Hygienic Transfer & Filling</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-300">Move sauces, juices, syrups and marinades cleanly and gently. PERIFLOW peristaltic pumps with FDA-grade tubing keep food contact hygienic and filling accurate.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <button type="button" data-quote-open class="rounded-lg bg-cta-orange px-6 py-3 text-center text-base font-semibold text-white shadow-lg transition hover:bg-orange-600">Request a Quote</button>
        <a href="/products/pump-heads/" class="rounded-lg border border-white/20 px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-white/10">View Pump Heads</a>
      </div>
    </div>
  </section>

  <!-- Why peristaltic -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">Why Peristaltic for Food</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Why Food & Beverage Processing Needs Peristaltic Pumps</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {why.map((w) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-navy-950">{w.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Application table -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">FOOD SCENARIOS</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Food & Beverage Application Scenarios</h2>
      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-navy-950 text-white">
            <tr>
              <th class="px-5 py-4 font-semibold">Application</th>
              <th class="px-5 py-4 font-semibold">Typical Requirement</th>
              <th class="px-5 py-4 font-semibold">Recommended Product</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tableRows.map((r) => (
              <tr class="transition hover:bg-slate-50">
                <td class="px-5 py-4 font-bold text-navy-950">{r.application}</td>
                <td class="px-5 py-4 text-slate-600">{r.requirement}</td>
                <td class="px-5 py-4 text-slate-600">{r.product}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Recommended products -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">RECOMMENDED</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Recommended for Food & Beverage</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {products.map((p) => (
          <a href={p.href} class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
            <h3 class="text-base font-bold text-navy-950">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue">View product <span class="transition group-hover:translate-x-0.5">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">FAQ</p>
      <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Food & Beverage Pump Questions</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer text-base font-bold text-navy-950">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Choosing a Food-Grade Pump?"
    subtitle="Tell us your product and fill volume — get an FDA-grade pump and tubing recommendation within 24 hours."
  />
</Layout>
