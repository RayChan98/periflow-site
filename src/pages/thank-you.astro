---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You | PERIFLOW" description="Thank you for your inquiry — our team will reply within 24 hours.">
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-brand-green/20 text-brand-green">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-8 w-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      </div>
      <h1 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl">Thank You!</h1>
      <p class="mt-4 text-lg text-slate-300">Your inquiry has been received. Our team will reply within 24 hours with pricing and lead times.</p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/" class="rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white transition hover:bg-orange-600">Back to Home</a>
        <a href="/products/" class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Explore Products</a>
      </div>
    </div>
  </section>
</Layout>
