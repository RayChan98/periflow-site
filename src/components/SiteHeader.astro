  { href: '/products/dosing-pumps/', label: 'Dosing Pumps', icon: '💧', desc: 'Chemical dosing & metering' },
  { href: '/products/oem-pumps/', label: 'OEM Pumps', icon: '🏭', desc: 'Custom pump solutions' },
