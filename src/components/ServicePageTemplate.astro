---
// Services 长尾页模板 v2（2026-08-24 升级：吸收 PLEATPURE 反哺——加 challenges/faqs/products/guides 深度段）
const { title, kw, desc, points, longtail, steps, faqs = [], challenges = [], products = [], guides = [] } = Astro.props;
---

<section class="bg-navy-950 text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <nav class="flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="transition hover:text-white">Home</a>
      <span>/</span>
      <a href="/services/" class="transition hover:text-white">Services</a>
      <span>/</span>
      <span class="text-slate-200">{title}</span>
    </nav>
    <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-brand-green">SERVICES</p>
    <h1 class="mt-2 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">{desc}</p>
    <button type="button" data-quote-open class="mt-6 inline-block rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white shadow-lg transition hover:bg-orange-600">Request a Quote</button>
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">WHAT WE OFFER</p>
    <h2 class="text-2xl font-extrabold text-navy-950 sm:text-3xl">What We Offer</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {points.map((p) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <span class="grid h-10 w-10 place-items-center rounded-lg bg-brand-blue/10 text-xl">✓</span>
          <h3 class="mt-4 text-lg font-bold text-navy-950">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold text-brand-blue">HOW IT WORKS</p>
        <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">From Inquiry to Delivery</h2>
        <div class="mt-6 space-y-4">
          {steps.map((s, i) => (
            <div class="flex items-start gap-4">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-950 text-sm font-bold text-white">{i + 1}</span>
              <div>
                <p class="font-semibold text-navy-950">{s.title}</p>
                <p class="mt-1 text-sm text-slate-600">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="text-sm font-semibold text-brand-blue">CHALLENGES</p>
        <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Challenges This Service Solves</h2>
        <div class="mt-6 space-y-4">
          {challenges.map((c) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <p class="font-semibold text-navy-950">{c.title}</p>
              <p class="mt-1 text-sm text-slate-600">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">FAQ</p>
    <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">{title} — FAQ</h2>
    <div class="mt-6 space-y-4">
      {faqs.map((f) => (
        <details class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <summary class="cursor-pointer text-base font-bold text-navy-950">{f.q}</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

{products.length > 0 && (
<section class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue">RELATED PRODUCTS</p>
    <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">Recommended for This Service</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <a href={p.href} class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <p class="text-sm font-bold text-navy-950">{p.title}</p>
          <p class="mt-1 text-xs text-slate-500">{p.desc}</p>
        </a>
      ))}
    </div>
    {guides.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {guides.map((g) => (
          <a href={g.href} class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-600 transition hover:border-brand-blue hover:text-brand-blue">{g.title}</a>
        ))}
      </div>
    )}
  </div>
</section>
)}

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold text-brand-blue">RELATED SEARCHES</p>
    <h2 class="mt-2 text-2xl font-extrabold text-navy-950 sm:text-3xl">What Buyers Search</h2>
    <div class="mt-6 flex flex-wrap gap-2">
      {longtail.map((l) => (
        <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 shadow-sm">{l}</span>
      ))}
    </div>
    <p class="mt-4 text-xs text-slate-400">* Keywords from Semrush competitor data — one page per search intent.</p>
  </div>
</section>
