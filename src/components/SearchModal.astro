---
// 搜索弹窗（istamping 模式）：点击放大镜弹出，大输入框 + 热门词 + ESC/遮罩关闭
const popular = [
  { label: 'Pump Heads', href: '/products/pump-heads/' },
  { label: 'Pump Tubing', href: '/products/tubing/' },
  { label: 'Benchtop Pumps', href: '/products/benchtop-pumps/' },
  { label: 'Dosing Pumps', href: '/products/dosing-pumps/' },
  { label: 'OEM Pumps', href: '/products/oem-pumps/' },
  { label: 'PTFE vs Silicone Tubing', href: '/blog/ptfe-vs-silicone-tubing/' },
];
---

<!-- 搜索弹窗 -->
<div id="search-modal" class="fixed inset-0 z-[190] hidden items-start justify-center p-4 pt-[18vh]" data-search-modal aria-hidden="true">
  <!-- 遮罩 -->
  <div class="absolute inset-0 bg-navy-950/70 backdrop-blur-sm" data-search-close></div>
  <!-- 面板 -->
  <div class="relative w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
    <button type="button" class="absolute right-4 top-4 rounded-full p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-navy-950" data-search-close aria-label="Close search">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
    </button>

    <p class="text-sm font-bold text-navy-950">Search</p>
    <p class="mt-1 text-xs text-slate-500">Find pumps, tubing and guides across PERIFLOW.</p>

    <form action="/search/" method="get" class="mt-5">
      <div class="relative">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
        <input
          type="search"
          name="q"
          placeholder="Search pumps, tubing, guides…"
          autocomplete="off"
          class="h-14 w-full rounded-xl border border-slate-200 bg-slate-50 pl-12 pr-4 text-base text-navy-950 placeholder-slate-400 transition focus:border-brand-blue focus:bg-white focus:outline-none"
        />
      </div>
      <button type="submit" class="mt-4 w-full rounded-xl bg-brand-blue py-3.5 text-sm font-semibold text-white transition hover:bg-blue-700">
        Search
      </button>
    </form>

    <div class="mt-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Popular searches</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {popular.map((p) => (
          <a href={p.href} class="rounded-full border border-slate-200 px-3 py-1.5 text-xs text-slate-600 transition hover:border-brand-blue hover:text-brand-blue">{p.label}</a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const openers = document.querySelectorAll('[data-search-open]');
  const closers = modal ? modal.querySelectorAll('[data-search-close]') : [];
  const input = modal ? modal.querySelector('input[type="search"]') : null;

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    input?.focus();
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openers.forEach((btn) => btn.addEventListener('click', (e) => { e.preventDefault(); openModal(); }));
  closers.forEach((btn) => btn.addEventListener('click', closeModal));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
