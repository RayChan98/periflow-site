---
const { title = 'Ready to Upgrade Your Surveillance?', subtitle = 'Factory-direct pricing, OEM/ODM options and lead times. Send your spec and volume, get a quote within 24 hours.' } = Astro.props;
---

<section class="bg-navy-900">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="flex flex-col items-center justify-between gap-8 rounded-2xl bg-navy-950 p-8 ring-1 ring-white/10 sm:p-12 lg:flex-row">
      <div class="max-w-2xl text-center lg:text-left">
        <h2 class="text-3xl font-extrabold tracking-tight text-white">{title}</h2>
        <p class="mt-3 text-base leading-relaxed text-slate-300">{subtitle}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="button" data-quote-open class="rounded-lg bg-cta-orange px-6 py-3 text-center text-base font-semibold text-white shadow-lg transition hover:bg-orange-600">Request a Quote</button>
        <button type="button" data-quote-open class="rounded-lg border border-white/20 px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-white/10">Contact Sales</button>
      </div>
    </div>
  </div>
</section>
