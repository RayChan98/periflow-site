---
// Blog 详情页三栏模板（参考 istamping.com 文章结构）
// 左：TOC 目录 | 中：正文 | 右：CTA block + Related 占位
const { title, category, date, readTime, author, toc, related } = Astro.props;
const children = await Astro.slots.render('default');
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: date,
  author: { '@type': 'Person', name: author, url: 'https://periflow.pages.dev/blog/authors/ray-chan/' },
  publisher: { '@type': 'Organization', name: 'PERIFLOW', url: 'https://periflow.pages.dev/' },
  mainEntityOfPage: `https://periflow.pages.dev${Astro.url.pathname.replace(/\/$/, '')}/`,
};
---
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

<article>
  <!-- 阅读进度条（仅 blog 详情页：fixed 于 header 下沿 104px，蓝→橙渐变 h-1.5） -->
  <div class="fixed inset-x-0 top-[104px] z-[140] h-1.5">
    <div class="h-full w-0 bg-gradient-to-r from-brand-blue to-cta-orange transition-[width] duration-150 ease-out" data-reading-bar></div>
  </div>

  <!-- Hero（深蓝黑 + 左右布局：左文案 | 右封面小图） -->
  <section class="bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_420px]">
        <!-- 左：文案 -->
        <div>
          <!-- 面包屑：远离 H1，留呼吸感 -->
          <nav class="mb-8 text-sm text-slate-400">
            <a href="/" class="transition hover:text-white">Home</a> <span class="mx-1">/</span>
            <a href="/blog/" class="transition hover:text-white">Blog</a> <span class="mx-1">/</span>
            <span class="text-slate-200">{category}</span>
          </nav>
          <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-400">
            <a href="/blog/authors/ray-chan/" class="inline-flex items-center gap-2 transition hover:text-white">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-blue text-sm font-bold text-white">RC</span>
              Ray Chan
            </a>
            <span>·</span>
            <span>{date}</span>
            <span>·</span>
            <span>{readTime} min read</span>
          </div>
        </div>
        <!-- 右：封面小图（非重点，不抢风头） -->
        <div class="lg:justify-self-end">
          <slot name="cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- 三栏主体：左 TOC | 中正文 | 右 CTA+Related -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)_18rem]">
        <!-- 移动端 TOC（折叠，Astro 最佳实践） -->
        <details class="group rounded-2xl border border-slate-200 bg-slate-50 lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4">
            <span class="text-sm font-bold text-navy-950">Table of Contents</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 text-slate-400 transition group-open:rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <nav class="space-y-1 px-5 pb-4">
            {toc.map((t, i) => (
              <a href={`#${t.id}`} class="flex items-baseline gap-2 rounded-lg px-2 py-1.5 text-sm leading-snug text-slate-600 transition hover:bg-white hover:text-brand-blue">
                <span class="text-xs font-semibold text-brand-blue">{i + 1}.</span>
                <span>{t.label}</span>
              </a>
            ))}
          </nav>
        </details>

        <!-- 左：TOC（sticky，桌面） -->
        <aside class="hidden lg:block">
          <div class="sticky top-[160px] rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-sm font-bold text-navy-950">Table of Contents</p>
            <nav class="mt-3 space-y-1.5">
              {toc.map((t, i) => (
                <a href={`#${t.id}`} class="flex items-baseline gap-2 text-sm leading-snug text-slate-500 transition hover:text-brand-blue">
                  <span class="text-xs font-semibold text-brand-blue">{i + 1}.</span>
                  <span>{t.label}</span>
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- 中：正文 -->
        <div class="min-w-0">
          <div class="prose prose-lg max-w-none prose-headings:font-extrabold prose-headings:text-navy-950 prose-h2:mt-12 prose-p:text-slate-600 prose-a:text-brand-blue">
            <slot />
          </div>

          <!-- 文末 CTA（istamping 模式） -->
          <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-8">
            <p class="text-sm font-semibold text-brand-blue uppercase tracking-wider">NEXT STEP</p>
            <h2 class="mt-2 text-2xl font-extrabold text-navy-950">Ready to Source Precision Peristaltic Pumps?</h2>
            <p class="mt-3 text-slate-600">Send us your requirements — our team responds within 24 hours with pricing and lead time.</p>
            <button type="button" data-quote-open class="mt-5 inline-block rounded-lg bg-cta-orange px-6 py-3 font-semibold text-white transition hover:bg-orange-600">Get a Quote</button>
          </div>

          <!-- 作者卡 -->
          <div class="mt-8 flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-6">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-brand-blue text-lg font-bold text-white">RC</span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Written by</p>
              <a href="/blog/authors/ray-chan/" class="text-sm font-bold text-navy-950 transition hover:text-brand-blue">Ray Chan</a>
              <p class="mt-1 text-sm leading-relaxed text-slate-500">Peristaltic Pump Specialist · Pump Head &amp; Tubing Expert. Ray helps global importers and OEMs source factory-direct peristaltic pumps.</p>
            </div>
          </div>

          <a href="/blog/" class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline">← Back to Blog</a>
        </div>

        <!-- 右：CTA + Related（sticky，占位） -->
        <aside class="hidden lg:block">
          <div class="sticky top-[160px] space-y-6">
            <div class="rounded-2xl bg-navy-950 p-6 text-white">
              <p class="text-sm font-bold">Looking for Volume Pricing?</p>
              <p class="mt-2 text-sm text-slate-300">OEM / ODM and wholesale inquiries welcome — factory direct.</p>
              <button type="button" data-quote-open class="mt-4 block rounded-lg bg-cta-orange px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-orange-600">Contact Sales</button>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <p class="text-sm font-bold text-navy-950">Related Articles</p>
              <div class="mt-4 space-y-4">
                {related.map((r) => (
                  <a href={r.href} class="block group">
                    <p class="text-sm font-semibold text-navy-950 transition group-hover:text-brand-blue">{r.title}</p>
                    <p class="mt-1 text-xs text-slate-400">{r.readTime} min read</p>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</article>

<script>
  // 阅读进度条（仅 blog 详情页）
  const bar = document.querySelector('[data-reading-bar]');
  const updateBar = () => {
    if (!bar) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
    bar.style.width = `${pct}%`;
  };
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { updateBar(); ticking = false; });
      ticking = true;
    }
  });
  window.addEventListener('resize', updateBar);
  updateBar();
</script>
