const aboutLinks = [
  { href: '/about/', label: 'About Us', icon: '🏢', desc: 'Company story & mission' },
  { href: '/about/#factory', label: 'Factory & Facility', icon: '🏭', desc: 'Production lines' },
  { href: '/about/#quality', label: 'Quality Control', icon: '✅', desc: 'Testing & inspection' },
  { href: '/about/#process', label: 'Production Process', icon: '⚙️', desc: 'QC gates' },
  { href: '/about/#certificates', label: 'Certificates & Compliance', icon: '📜', desc: 'CE, ISO, RoHS' },
