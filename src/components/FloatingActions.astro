---
// 右侧 sticky 快速联系浮动栏（molditquick 模式）
// 桌面：展开态带文案（WhatsApp/Call/Quote/Back to top）
// 移动：纯图标右对齐 + bottom-20 避开底部菜单栏，展开按钮无文案
interface Props {
  whatsappNumber?: string;
  phoneDisplay?: string;
  welcomeText?: string;
  email?: string;
}
const {
  whatsappNumber = '8613710860663',
  phoneDisplay = '+86 137 1086 0663',
  welcomeText = "Hello PERIFLOW! I'm interested in your peristaltic pumps and tubing. Could you send me the price list and lead time?",
  email = 'cj226144@gmail.com',
} = Astro.props;

const waLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(welcomeText)}`;
const telLink = `tel:+${whatsappNumber}`;
---

<div class="floating-actions fixed right-3 bottom-3 z-50 flex flex-col items-end gap-3 lg:right-4 lg:bottom-4 lg:gap-5" data-floating-actions>
  <!-- 展开态面板：呼吸感 gap-4/gap-5，按钮 w-fit 按文案自动对齐 -->
  <div id="fa-panel" class="hidden flex flex-col items-end gap-4 lg:gap-5" data-fa-panel>
    <!-- WhatsApp -->
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-fit items-center gap-2.5 rounded-full bg-[#25D366] px-3 py-3 text-sm font-semibold text-white shadow-lg transition hover:brightness-110 lg:px-5"
      aria-label="Chat with us on WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      <span class="hidden lg:inline">Chat with us on WhatsApp</span>
    </a>
    <!-- Call -->
    <a
      href={telLink}
      class="flex w-fit items-center gap-2.5 rounded-full bg-brand-blue px-3 py-3 text-sm font-semibold text-white shadow-lg transition hover:brightness-110 lg:px-5"
      aria-label="Call us"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
      <span class="hidden lg:inline">Call us</span>
    </a>
    <!-- Quote (opens popup) —— 换 icon（文档样式，避免与开关气泡重复）+ 换色 -->
    <button
      type="button"
      class="flex w-fit items-center gap-2.5 rounded-full bg-[#0EA5E9] px-3 py-3 text-sm font-semibold text-white shadow-lg transition hover:brightness-110 lg:px-5"
      data-quote-open
      aria-label="Get a Quote"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
      <span class="hidden lg:inline">Get a Quote</span>
    </button>
    <!-- Back to top -->
    <button
      type="button"
      class="flex w-fit items-center gap-2.5 rounded-full border border-slate-200 bg-white px-3 py-3 text-sm font-semibold text-navy-950 shadow-lg transition hover:bg-slate-50 lg:px-5"
      data-fa-top
      aria-label="Back to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" /></svg>
      <span class="hidden lg:inline">Back to top</span>
    </button>
  </div>

  <!-- 折叠/展开切换按钮：移动纯图标，桌面带文案 -->
  <button
    type="button"
    class="fa-toggle flex w-fit items-center gap-2.5 rounded-full bg-gradient-to-r from-cta-orange to-orange-500 px-3 py-3 text-sm font-bold text-white shadow-xl ring-2 ring-white/20 transition hover:from-orange-500 hover:to-orange-600 lg:px-5"
    data-fa-toggle
    aria-expanded="false"
    aria-controls="fa-panel"
    aria-label="Quick contact"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.76 9.76 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" /></svg>
    <span class="hidden lg:inline">Quick Contact</span>
  </button>
</div>

<style>
  /* 移动端：浮动栏上移避开底部菜单栏（bottom nav 高约 60px + safe-area） */
  @media (max-width: 1023px) {
    [data-floating-actions] {
      bottom: 4.5rem !important;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-floating-actions]');
  const panel = root?.querySelector('[data-fa-panel]');
  const toggle = root?.querySelector('[data-fa-toggle]');
  const topBtn = root?.querySelector('[data-fa-top]');

  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    // 切换图标状态（可选：旋转/变色）
  });

  topBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
