const servicesLinks = [
  { href: '/services/', label: 'All Services', icon: '🛠️', desc: 'Full service overview' },
  { href: '/services/oem-odm/', label: 'OEM & ODM', icon: '🏷️', desc: 'Private-label pump manufacturing' },
  { href: '/services/wholesale-distribution/', label: 'Wholesale & Distribution', icon: '📦', desc: 'Bulk & trade pricing' },
  { href: '/services/technical-support/', label: 'Technical Support', icon: '🔧', desc: 'Selection & tubing guidance' },
];
